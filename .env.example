# Copie este arquivo para .env e ajuste os dados do seu MySQL
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=melo_barbearia
DB_USER=root
DB_PASS=

APP_TZ=America/Recife

# Texto aleatório e longo (sem ele, os logins caem ao reiniciar o servidor)
SESSION_SECRET=troque-por-um-texto-grande-e-aleatorio

# Use true somente em produção com HTTPS
SESSION_SECURE=false
TRUST_PROXY=false
